function renderRanking(key){
const ms=methods(), allDs=datasets(), policy=document.getElementById("rankPolicy")?.value||"all", dir=metricDirection(key);
if(!key || !ms.length){document.getElementById("rankTable").innerHTML=emptyHTML();return}
if(dir==="context"){
document.getElementById("rankPlot").innerHTML=emptyHTML("Context-only metric","This metric has no canonical maximize/minimize direction and is intentionally not ranked automatically.");
document.getElementById("rankTable").innerHTML=`<div class="callout warn"><b>Not automatically rankable.</b> ${esc(metricLabel(key))} is marked context-only in the metric registry. Choose a directional metric for cross-method ranking.</div>`;
return;
}
const commonDs=allDs.filter(d=>ms.every(m=>state.reports.some(r=>r.dataset===d&&r.method===m&&isNum(metricValue(r,key)))));
const ds=policy==="common"?commonDs:allDs;
const datasetRanks={};
for(const d of ds){
const vals=state.reports.filter(r=>r.dataset===d).map(r=>({m:r.method,v:metricValue(r,key)})).filter(x=>isNum(x.v)).sort((a,b)=>dir==="minimize"?a.v-b.v:b.v-a.v);
const ranks=new Map();
for(let i=0;i<vals.length;){
let j=i+1;
const anchor=vals[i].v;
const tied=(x)=>Math.abs(x-anchor)<=1e-12*Math.max(1,Math.abs(anchor),Math.abs(x));
while(j<vals.length&&tied(vals[j].v))j++;
const averageRank=((i+1)+j)/2;
for(let k=i;k<j;k++)ranks.set(vals[k].m,averageRank);
i=j;
}
datasetRanks[d]=ranks;
}
const rows=ms.map(m=>{
const vals=[],ranks=[],covered=[];
for(const d of ds){
const r=state.reports.find(x=>x.method===m&&x.dataset===d); const v=r?metricValue(r,key):null;
if(isNum(v)){vals.push(v);covered.push(d);const rk=datasetRanks[d]?.get(m);if(rk)ranks.push(rk)}
}
return {m,meanScore:mean(vals),meanRank:mean(ranks),n:vals.length,covered};
}).sort((a,b)=>(a.meanRank??Infinity)-(b.meanRank??Infinity));
const valid=rows.filter(x=>isNum(x.meanRank));
if(valid.length){
prepPlot("rankPlot");
Plotly.react("rankPlot",[{type:"scatter",mode:"markers+text",name:"Mean rank",x:valid.map(x=>x.meanRank),y:valid.map(x=>x.m),
marker:{size:13,color:valid.map((_,i)=>COLORS[i%COLORS.length])},text:valid.map(x=>`rank ${fmt(x.meanRank)} · ${x.n} ds`),textposition:"middle right",cliponaxis:false,
hovertemplate:"%{y}<br>Mean rank: %{x:.3f}<extra></extra>"}],
{margin:{l:130,r:150,t:25,b:60},xaxis:{title:"Mean within-dataset rank · 1 = best",dtick:1,range:[0.7,Math.max(1.3,...valid.map(x=>x.meanRank+.45))]},yaxis:{autorange:"reversed"},paper_bgcolor:"white",plot_bgcolor:"white",showlegend:false},
{responsive:true,displaylogo:false});
} else document.getElementById("rankPlot").innerHTML=emptyHTML(policy==="common"?"No strict common dataset has this metric":"Selected metric is unavailable");
const policyText=policy==="common"?`Strict common-dataset mode: ${commonDs.join(", ")||"no shared datasets"}.`:`All-available mode: each method contributes only where the selected metric exists.`;
const seedCounts=unique(state.reports.map(r=>r.metrics?.[key]?.n).filter(x=>Number.isFinite(x)));const seedWarning=state.seedMode==="aggregate"&&seedCounts.length>1?` ⚠ Unequal included-seed counts are present (${seedCounts.join(", ")}); inspect uncertainty before interpreting small rank differences.`:"";
document.getElementById("rankTable").innerHTML=`<div class="callout" style="margin-bottom:9px"><b>Ranking policy:</b> ${esc(policyText+seedWarning)} Metric direction: <b>${dir==="minimize"?"lower is better ↓":"higher is better ↑"}</b>. Missing values are never converted to zero.</div>
<div class="table-wrap"><table><thead><tr><th>Method</th><th>Mean score</th><th>Mean rank</th><th>Datasets with metric</th><th>Coverage</th></tr></thead><tbody>`+
rows.map(x=>`<tr><td><b>${esc(x.m)}</b></td><td>${fmt(x.meanScore)}</td><td>${fmt(x.meanRank)}</td><td>${x.n}</td><td>${esc(x.covered.join(", ")||"—")}</td></tr>`).join("")+`</tbody></table></div>`;
}
